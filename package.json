{
  "name": "mvvm",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.6",
  "description": "",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./*": {
      "import": "./dist/*",
      "module-sync": "./dist/*",
      "types": "./types/*"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "module-sync": "./dist/react/index.js",
      "types": "./types/react/index.d.ts"
    },
    "./preact": {
      "import": "./dist/preact/index.js",
      "module-sync": "./dist/preact/index.js",
      "types": "./types/preact/index.d.ts"
    },
    "./forms": {
      "import": "./dist/forms/index.js",
      "module-sync": "./dist/forms/index.js",
      "types": "./types/forms/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && npx tsc"
  },
  "devDependencies": {
    "preact": "^10.28.3",
    "typescript": "7"
  }
}
